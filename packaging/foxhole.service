[Unit]
Description=Foxhole DNS ad blocker
Documentation=https://github.com/FlashFennec22/Foxhole-Linux
Requires=systemd-resolved.service
After=systemd-resolved.service network.target
# A start that fails (bad config.toml, port 53 taken) is retried after 10 s, growing to 2 min;
# after 5 failures in 10 minutes systemd gives up until `foxhole on` or the next boot.
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=notify
ExecStart=@BINDIR@/foxhole service
# "+" runs these as root, outside the sandbox below: they edit systemd-resolved's settings.
# ExecStartPost runs once the resolver reports ready, so DNS only points at it once it can answer.
# ExecStop takes it back out before the resolver stops; ExecStopPost also runs after a crash or a
# failed start, so the machine never keeps pointing at a resolver that isn't there (fail open).
ExecStartPost=+@BINDIR@/foxhole dns-apply
ExecStop=+@BINDIR@/foxhole dns-restore
ExecStopPost=+@BINDIR@/foxhole dns-restore
# Stopping takes well under a second; don't let anything that hangs hold up a restart for systemd's
# default 90 s.
TimeoutStopSec=15s
Restart=on-failure
RestartSec=10s
RestartSteps=3
RestartMaxDelaySec=2min

User=foxhole
Group=foxhole
StateDirectory=foxhole
StateDirectoryMode=0755
ConfigurationDirectory=foxhole
ConfigurationDirectoryMode=0755
UMask=0022

# Port 53 is the only privilege the resolver needs.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
